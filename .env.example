# ===========================================
# Open Source Billing - Koyeb Deployment
# Environment Variables
# ===========================================

# Rails Configuration
RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
SECRET_KEY_BASE=your_secret_key_base_here

# Server Port (Koyeb default is 8000)
PORT=8000

# Database Configuration (PostgreSQL)
DATABASE_HOST=your_db_host_here
DATABASE_NAME=your_db_name_here
DATABASE_USER=your_db_user_here
DATABASE_PASSWORD=your_db_password_here
DATABASE_PORT=5432

# Application Configuration
APP_HOST=your-app.koyeb.app
APP_PROTOCOL=https
ENCRYPTION_KEY=your_encryption_key_here

# PayPal Configuration (Optional)
# PAYPAL_ENABLED=false
# PAYPAL_URL=https://www.paypal.com/cgi-bin/webscr?
# PAYPAL_BUSINESS=your_paypal_business

# SMTP Configuration (Optional)
# SMTP_ADDRESS=smtp.gmail.com
# SMTP_PORT=587
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true
# SMTP_USER_NAME=your_email@gmail.com
# SMTP_PASSWORD=your_email_password

# QuickBooks Configuration (Optional)
# QUICKBOOKS_CONSUMER_KEY=your_quickbooks_consumer_key
# QUICKBOOKS_CONSUMER_SECRET=your_quickbooks_consumer_secret
